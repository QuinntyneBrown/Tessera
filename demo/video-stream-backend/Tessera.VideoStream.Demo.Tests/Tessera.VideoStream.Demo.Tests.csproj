<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tessera.VideoStream.Demo.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tessera.VideoStream.Demo\Tessera.VideoStream.Demo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed fixture shared with the video player tests (tools/generate-video-fixture.mjs). -->
    <None Include="..\..\..\src\e2e-app\public\lecture-10s.fmp4" Link="Fixtures\lecture-10s.fmp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
