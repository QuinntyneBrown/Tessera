/.angular/combobox-packed-consumer/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
/.claude/
/test-results/
/playwright-report/
/demo/.run/

# Local theme verification artifacts
/.angular/theme-*
/.angular/node-x64.exe
