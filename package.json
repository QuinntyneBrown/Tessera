{
  "name": "tessera",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve dev-app",
    "build": "ng build scorm-player && ng build combobox",
    "test": "ng test scorm-player",
    "e2e": "playwright test --grep-invert \"render-latency samples\"",
    "e2e:performance": "playwright test test/e2e/combobox-performance.spec.ts --workers=1",
    "e2e:packed": "node -e \"require('node:fs').mkdirSync('dist/packages', {recursive: true})\" && npm pack ./dist/combobox --pack-destination ./dist/packages && node tools/combobox-packed-smoke.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "api:update": "pnpm build && api-extractor run --local -c tools/public_api_guard/api-extractor.json && api-extractor run --local -c tools/public_api_guard/combobox-api-extractor.json",
    "api:check": "api-extractor run -c tools/public_api_guard/api-extractor.json && api-extractor run -c tools/public_api_guard/combobox-api-extractor.json",
    "demo:record": "node demo/run.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "fflate": "^0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@microsoft/api-extractor": "^7.59.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
