@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Remove and navigate chips
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Host form" #E0F2FE
  participant "Value and touched callbacks" as fc
end box


user -> cb : Backspace with empty query
cb -> cb : Commit without last item; keep input focus (L2-033)
cb -> fc : Report user removal
user -> cb : Inline-start arrow at input caret zero
cb -> cb : Read computed direction; focus last remove button
user -> cb : Horizontal arrow on chip
cb -> cb : Focus previous/next; last forward returns to input (L2-034)
user -> cb : Enter, Space, Delete or Backspace on chip
cb -> cb : preventDefault; focus surviving destination; removeChip(index)
cb -> fc : User change once
user -> cb : Tab or Shift+Tab
cb -> cb : Close popup without preventing native Tab
opt Focus leaves host and pane
  cb -> fc : onTouched once per exit
end
@enduml
