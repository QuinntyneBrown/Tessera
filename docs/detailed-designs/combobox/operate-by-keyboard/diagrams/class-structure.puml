@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - operate by keyboard
class "Combobox<T>" as Combo {
  -navigationIntent: boolean
  -openingMode: normal | last | none
  #onKeydown(event: KeyboardEvent): void
  #onChipKeydown(event: KeyboardEvent, index: number): void
  #onHostKeydown(event: KeyboardEvent): void
  #onCursorMove(): void
  -previousChipKey(): string
  #toggle(item: T): void
  #removeChip(index: number): void
  #retry(): void
  #loadMore(): void
}
class "ActiveDescendantKeyManager<ComboboxOption>" as Keys <<CDK>> {
  +onKeydown(event: KeyboardEvent): void
  +setActiveItem(index: number): void
  +change: Subject<number>
}
interface Highlightable <<CDK>> {
  +setActiveStyles(): void
  +setInactiveStyles(): void
}
class ComboboxOption {
  +active: WritableSignal<boolean>
  +disabled: boolean <<getter>>
}
Combo "1" *-- "0..1" Keys
Keys --> "*" ComboboxOption : tracks without skip or wrap
ComboboxOption ..|> Highlightable
@enduml
