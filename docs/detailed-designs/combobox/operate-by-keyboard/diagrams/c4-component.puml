@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - operate by keyboard
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "onKeydown, onChipKeydown and onHostKeydown interpret keyboard input")
  Component(option, "ComboboxOption", "Highlightable directive", "Highlights active host and adjusts listbox scrollTop")
  Component(ann, "ComboboxAnnouncer", "Text queue", "Preserves formatted removal and selection messages")
}
Rel(combo, option, "Reads discovered hosts and binds state")
Rel(combo, ann, "Queues user-change messages")
Container_Ext(cdk, "Angular CDK", "Browser library", "Overlay and ActiveDescendantKeyManager")
Rel(combo, cdk, "Uses overlay and/or active-descendant APIs")
@enduml
