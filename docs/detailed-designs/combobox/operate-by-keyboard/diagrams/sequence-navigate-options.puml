@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Navigate and select by keyboard
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "ActiveDescendantKeyManager" as keys
end box


user -> cb : Arrow Down/Up while closed
cb -> cb : Open normal/last mode; Alt Down uses none
cb -> keys : Set active item after render (L2-033)
user -> cb : Plain vertical arrow while open
alt Arrow Down at last option and hasMore
  cb -> cb : loadMore(); preserve active item
else Other plain arrow
  cb -> keys : onKeydown(event); no wrap or disabled skip
end
user -> cb : Page Down/Up
cb -> keys : Clamp by fully visible row count, at least one
user -> cb : Enter or Space
alt Enter in error
  cb -> cb : retry(); prevent submission
else Enter with active option, or Space with navigationIntent
  cb -> cb : toggle(results[activeIndex]); disabled item ignored
else Open Enter without active option
  cb -> cb : guarded loadMore(); prevent submission
else Text editing or closed Enter
  cb --> user : Native text insertion or submission
end
user -> cb : Escape
cb -> cb : Tooltip, then popup, then non-empty input text
cb --> user : Consume handled Escape; otherwise containing dialog receives it
@enduml
