@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Run automated accessibility verification
actor "Maintainer" as user
box "Frontend - Playwright Chromium test" #E0F2FE
  participant "Feature spec" as test
  participant "ComboboxDemoPage" as page
  participant "AxeBuilder" as axe
end box
box "Frontend - Acceptance app" #E0F2FE
  participant "ComboboxFixture" as fixture
  participant "Combobox<T>" as cb
end box


user -> test : Run Chromium acceptance suite (L2-048)
test -> page : open(parameter record); drive intended state
page -> fixture : Query parameters configure independent mock source
fixture -> cb : Bind inputs, forms and optional slots
page -> cb : Search, navigate, select or leave required control
test -> page : expectNoAccessibilityViolations()
page -> axe : Analyze whole page with WCAG A/AA tags
axe -> cb : Inspect rendered states and relationships
axe --> page : violations
page --> test : Require zero violations and zero captured errors
opt Responsive or keyboard checks
  test -> page : useViewport, enlargeText, applyTextSpacing, pressKey
  page -> cb : Apply condition and exercise behavior
  page --> test : State, focus and geometry assertions
end
test --> user : Automated result; manual release matrix remains separate
@enduml
