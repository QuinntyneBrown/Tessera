@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - verify and document
Container_Boundary(pkg, "@tessera/combobox") {
  Component(harness, "ComboboxHarness", "CDK ComponentHarness", "Root-exported consumer interactions and state reads")
}
Container_Boundary(tests, "Playwright in Chromium") {
  Component(page, "ComboboxDemoPage", "Playwright page object", "Owns selectors, fixture parameters, axe and measurements")
}
Container_Boundary(app, "Acceptance application in Chromium") {
  Component(fixture, "ComboboxFixture", "Angular acceptance host", "Provides independent configurable source and hosts component")
  Component(contract, "runHarnessContract", "Browser TestBed bridge", "Exercises real harness with explicit timing")
}
Container_Boundary(records, "Product documentation") {
  Component(docs, "README and verification records", "Markdown", "Adoption contract, measured evidence and pending manual matrix")
}
Rel(page, fixture, "Opens parameterized scenario and operates screen")
Rel(fixture, contract, "Runs TestBed harness contract")
Rel(contract, harness, "Calls public harness methods")
Rel(docs, harness, "Documents consumer testing")
@enduml
