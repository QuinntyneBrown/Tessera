@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Operate from a consumer test
actor "Consumer developer" as user
box "Frontend - Consumer TestBed test" #E0F2FE
  participant "Consumer test / timing control" as test
end box
box "Frontend - Package" #E0F2FE
  participant "ComboboxHarness" as harness
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "TestbedHarnessEnvironment" as env
end box


user -> test : Run browser harness contract (L2-047)
test -> env : Obtain harnesses; use manualChangeDetection for timing
env --> test : Harness for chosen instance
test -> harness : open()
harness -> cb : Click input when closed
test -> harness : search(text)
harness -> cb : Focus, clear and send non-empty keys
test -> test : Detect changes, advance/await debounce, render results
test -> harness : getOptions()
harness -> cb : Read document-root list via own input aria-controls
harness --> test : Trimmed host text, selected and disabled states
test -> harness : toggleOption(label or index), getChips(), removeChip()
harness -> cb : Native click on matched owned target
harness --> test : Result, or missing-target rejection
note over harness
  Public interactions and semantic state; no private component calls.
  Stabilization follows the selected environment.
end note
@enduml
