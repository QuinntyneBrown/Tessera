@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Secure and perform

Person(user, "End user", "Types and selects")
Person(tester, "Test engineer", "Measures timings, injection, and teardown in Chromium")
System_Boundary(app, "Host Angular application") {
  Container(hostcode, "Host templates", "Angular", "Binds searchFn, value, and optional slot templates")
  Container(pkg, "@tessera/combobox", "Angular library", "Renders text, generates ids, debounces searches, and tears down on destroy")
  Container(core, "Angular core", "Signals, DestroyRef, zoneless scheduler", "Schedules rendering and runs destroy callbacks")
  Container(cdk, "@angular/cdk", "Angular library", "Overlay and key manager")
}
System_Ext(source, "Consumer data source", "Returns untrusted items")
Container(e2e, "e2e-app", "Angular application, provideZonelessChangeDetection", "Hosts ComboboxScenario fixtures with hostile data and timing controls")
Container(tests, "Playwright acceptance tests", "Playwright, Chromium, CDP", "Run ComboboxDemoPage timing, injection, and teardown checks")
Rel(user, hostcode, "Uses", "Browser")
Rel(hostcode, pkg, "Binds inputs and templates of", "Angular template")
Rel(pkg, core, "Writes signals and registers cleanup with")
Rel(pkg, cdk, "Uses", "TypeScript import")
Rel(pkg, source, "Calls searchFn on", "Consumer-defined")
Rel(e2e, pkg, "Hosts and mounts")
Rel(tester, tests, "Runs")
Rel(tests, e2e, "Drives and measures", "Playwright, CDP")
@enduml
