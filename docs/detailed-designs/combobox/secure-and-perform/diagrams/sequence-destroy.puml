@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Release resources on destroy
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular/CDK" #E0F2FE
  participant "DestroyRef and view lifecycle" as destroy
  participant "Popup and tooltip OverlayRef" as overlay
end box
box "Frontend - Consumer source" #E0F2FE
  participant "searchFn subscription" as src
end box
box "Frontend - Announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box


user -> destroy : Remove host component
destroy -> cb : Destroy view; complete takeUntilDestroyed streams (L2-046)
cb -> src : Unsubscribe current source; finalize clears loading timer
cb -> cb : Clear tooltip timer; stop tracking; unsubscribe control events
cb -> overlay : Dispose attached or detached popup and tooltip
overlay --> cb : Panes and dispatcher ownership released
cb -> cb : Destroy active-descendant key manager
destroy -> ann : Clear quiet and write timers
destroy --> user : Host bindings, live region and scoped fallback container removed
note over cb
  Query pipeline teardown clears debounce.
  Later scroll/resize/click has no component handler.
  Shared application CDK resources may remain at warm-up baseline.
end note
@enduml
