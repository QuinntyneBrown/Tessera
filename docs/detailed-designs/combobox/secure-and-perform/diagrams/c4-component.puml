@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - secure and perform
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "OnPush component", "Owns component ID counter, request subscriptions, overlay and control cleanup")
  Component(option, "ComboboxOption", "Directive", "Owns independent generated option ID and active signal")
  Component(ann, "ComboboxAnnouncer", "Text queue", "Owns quiet and write timers; signals render as text")
  Component(fallback, "ComboboxOverlayContainer", "Scoped container", "Inherited container teardown")
}
Rel(combo, option, "Binds text data and ARIA states")
Rel(combo, ann, "Passes formatted text")
Rel(combo, fallback, "Provides instance-scoped fallback")
Container_Ext(cdk, "Angular CDK", "Browser library", "Overlay and ActiveDescendantKeyManager")
Rel(combo, cdk, "Uses overlay and/or active-descendant APIs")
@enduml
