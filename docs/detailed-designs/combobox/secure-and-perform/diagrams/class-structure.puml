@startuml
title Class structure - Secure and perform
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class "Combobox<T>" as Combobox {
  +changeDetection: OnPush
  +query: WritableSignal of string
  +isOpen: WritableSignal of boolean
  +activeIndex: WritableSignal of number
  +ids: ComboboxIds
  -destroyRef: DestroyRef
  -registerTeardown(): void
}
class ComboboxIds {
  +uid: number
  +input: string
  +listbox: string
  +hint: string
  +error: string
  +summary: string
  +chips: string
  +nextOptionId(): string
}
interface ComboboxParent <<COMBOBOX_PARENT>> {
  +nextOptionId(): string
}
class "ComboboxSearch<T>" as ComboboxSearch {
  +results: Signal of T[]
  +status: Signal of idle or loading or error
  +retry(): void
  +loadNextPage(): void
  -subscription: Subscription
}
class "ComboboxOption<T>" as ComboboxOption {
  +id: string
  +item: T
  +label: string
}
class ComboboxPopup {
  -overlayRef: OverlayRef
  -widthObserver: ResizeObserver
  +open(): void
  +close(): void
  +dispose(): void
}
class ComboboxAnnouncer {
  -timers: Set of timer handle
  +announce(text: string, politeness: polite or assertive): void
  +dispose(): void
}
Combobox "1" *-- "1" ComboboxIds : generates once
Combobox "1" *-- "1" ComboboxSearch
Combobox "1" *-- "0..1" ComboboxPopup
Combobox "1" *-- "1" ComboboxAnnouncer
Combobox "1" *-- "*" ComboboxOption : renders
Combobox ..|> ComboboxParent
Combobox ..> ComboboxIds : delegates nextOptionId to
ComboboxOption ..> ComboboxParent : requests id from
@enduml
