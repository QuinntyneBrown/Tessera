@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - secure and perform
class "Combobox<T>" as Combo {
  -uid: number
  -destroyRef: DestroyRef
  -popup: OverlayRef | undefined
  -tooltip: OverlayRef | undefined
  -widthObserver: ResizeObserver | undefined
  -controlSubscription: Subscription | undefined
  -stopPopupTracking(): void
  -hideTooltip(): void
}
class ComboboxOption {
  +id: string
  +active: WritableSignal<boolean>
}
class ComboboxAnnouncer {
  -quietTimer: timer handle | undefined
  -writeTimer: timer handle | undefined
  +message: WritableSignal<string>
}
class DestroyRef <<Angular>> {
  +onDestroy(callback): void
}
class OverlayRef <<CDK>> {
  +dispose(): void
}
Combo ..> DestroyRef : subscribes and registers cleanup
Combo "1" *-- "0..2" OverlayRef : popup and tooltip
Combo "1" *-- "1" ComboboxAnnouncer
ComboboxAnnouncer ..> DestroyRef : clears timers
Combo "1" --> "*" ComboboxOption : independent generated IDs
@enduml
