@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Render untrusted data as text
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box
box "Frontend - Component template" #E0F2FE
  participant "Instance live region" as live
end box
box "Frontend - Consumer source" #E0F2FE
  participant "searchFn" as src
end box


cb -> cb : Assign component UID; generated list/description IDs
user -> cb : Type markup or long query text
cb -> src : Pass exact query string after debounce (L2-044)
src --> cb : Items whose labels contain markup
cb -> cb : Bind labels through Angular text interpolation
cb --> user : Literal option, chip, summary and tooltip text
user -> cb : Select hostile-label item
cb -> ann : selection(formatted literal label)
ann -> live : Bind message signal as text
live --> user : No label markup interpreted
note over cb
  Option IDs use independent directive counter; item data never supplies IDs.
  Consumer templates and transport encoding remain host responsibilities.
end note
@enduml
