@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Toggle an option
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Host application" #E0F2FE
  participant "Bound value/form" as host
end box
box "Frontend - Package announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box


user -> cb : Pointer click or input keyboard activation
alt Disabled component or option
  cb --> user : No value change or selection event
else Enabled
  cb -> cb : Find item using compareWith (L2-028)
  cb -> cb : Add result item or remove stored instance
  cb -> host : value update, onChange and selectionChange once (L2-026)
  cb -> ann : selection(formatted addition or removal)
  opt Addition reaches limit
    cb -> ann : selection(formatted maximum message)
  end
  cb -> cb : Focus input; retain popup
  opt Addition and clearSearchOnSelect
    cb -> cb : changeQuery empty text
  end
  cb --> user : Chips and option state reflect new value
end
@enduml
