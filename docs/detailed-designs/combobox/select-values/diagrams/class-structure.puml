@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - select values
class "Combobox<T>" as Combo {
  +value: ModelSignal<T[]>
  +compareWith: InputSignal<(a: T, b: T) => boolean>
  +displayWith: InputSignal<(item: T) => string>
  +maxSelections: InputSignal<number | null>
  #canSelectMore: Signal<boolean>
  #toggle(item: T): void
  #removeChip(index: number): void
  #clearAll(): void
  -commit(next: T[], change: {added?: T, removed?: T}): void
}
interface "ComboboxSelectionChange<T>" as Change {
  +added?: T
  +removed?: T
  +value: T[]
}
class ComboboxOption {
  +selected: InputSignal<boolean>
  +isDisabled: InputSignal<boolean>
  +disabled: boolean <<getter>>
}
class ComboboxAnnouncer {
  +selection(text: string): void
}
Combo ..> Change : emits for user changes
Combo "1" --> "*" ComboboxOption : binds state
Combo "1" *-- "1" ComboboxAnnouncer : owns queue
@enduml
