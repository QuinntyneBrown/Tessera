@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Remove chips and write values
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Host application" #E0F2FE
  participant "Bound value/form" as host
end box


alt Chip removal
  user -> cb : removeChip(index)
  cb -> cb : Focus next button, else previous, else input
  cb -> host : Commit value without indexed item; selectionChange (L2-027)
else Clear-all
  user -> cb : clearAll()
  cb -> cb : Hide tooltip; focus input before commit
  cb -> host : Commit []; event has value only (L2-027)
else Programmatic write
  host -> cb : writeValue or new model array
  cb -> cb : Render chips directly from value
  cb --> host : No selectionChange or selection announcement
end
@enduml
