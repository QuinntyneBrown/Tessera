@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - select values
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Owns value, comparison, toggle, commit, removeChip and clearAll")
  Component(option, "ComboboxOption", "Directive", "Binds selected and disabled inputs; owns ARIA state")
  Component(slot, "ComboboxChipTemplate<T>", "Template directive", "Supplies optional chip content")
  Component(ann, "ComboboxAnnouncer", "Text queue", "Preserves formatted selection and limit messages")
}
Rel(combo, option, "Binds selected and disabled state")
Rel(combo, slot, "Reads contentChild and renders template")
Rel(combo, ann, "Calls selection(text) after user commit")
@enduml
