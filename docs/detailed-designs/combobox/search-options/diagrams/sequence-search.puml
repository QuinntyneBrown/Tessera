@startuml
title UML sequence behaviour - Trigger and cancel a search
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Application user" as user
box "Frontend - @tessera/combobox" #E0F2FE
  participant "Combobox<T>" as combo
  participant "ComboboxSearch<T>" as search
end box
box "Frontend - Consumer data source" #E0F2FE
  participant "searchFn" as fn
end box
box "Backend - Consumer API" #D1FADF
  participant "Search endpoint" as api
end box

user -> combo : Type "a"
alt IME composition in progress
  combo -> combo : Keep query unchanged until compositionend (L2-022)
else not composing
  combo -> search : Set query signal
end
search -> search : Debounce debounceMs, drop identical query (L2-022)
search --> combo : Emit searchChange once (L2-022)
alt query shorter than minSearchLength
  search -> search : Cancel in-flight request, status idle, no call (L2-022)
else query long enough
  search -> fn : searchFn("a", 0), status loading
  fn -> api : Request page
end
user -> combo : Type "b" while "a" is in flight
combo -> search : Set query "ab"
search -> search : Debounce completes (L2-022)
search -> fn : Unsubscribe "a" request (L2-023)
fn -> api : Abort "a" request
search -> fn : searchFn("ab", 0)
fn -> api : Request page
api --> fn : "ab" page
fn --> search : ComboboxPage for "ab"
note over search
  A late "a" response never reaches the reducer:
  no state change, no announcement (L2-023)
end note
search --> combo : results and status idle
combo --> user : Render options for "ab"
user -> combo : Component becomes disabled while loading
combo -> search : cancel() (L2-023)
search -> fn : Unsubscribe in-flight request
@enduml
