@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Trigger and cancel a search
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Consumer data source" #E0F2FE
  participant "searchFn" as src
end box


user -> cb : Edit input text (L2-022)
cb -> cb : Set query; mark pending; invalidate subscription immediately
opt Request in flight
  cb -> src : Unsubscribe before debounce (L2-023)
end
alt IME composing
  cb -> cb : Update visible text; wait for compositionend
else Normal text or completed composition
  cb -> cb : queries Subject debounces with current delay
  cb --> user : searchChange for a changed committed text
  alt Below minimum
    cb -> cb : Clear results, total and paging state; show instruction
  else Eligible and not already completed
    cb -> src : defer(searchFn(query, 0)); take first page
    src --> cb : ComboboxPage
    cb -> cb : Replace results and record completed query
  end
end
opt Disabled or configuration changed
  cb -> src : Invalidate subscription
  cb -> cb : Cancel pending query and search announcements
end
@enduml
