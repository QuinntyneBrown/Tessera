@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Result states, retry and paging
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Consumer data source" #E0F2FE
  participant "searchFn" as src
end box


cb -> src : Request query/page; status loading (L2-024)
cb --> user : Previous options and loading state remain visible
alt Page delivered
  src --> cb : items, total and hasMore
  cb -> cb : Replace page 0 or append later page; record pageIndex
  cb --> user : Idle results or empty state; aria-busy false
else Error, synchronous throw or empty completion
  src --> cb : Recoverable error
  cb -> cb : Inner catchError sets error; results unchanged
  cb --> user : Error row with Retry
  user -> cb : Retry button or input Enter
  cb -> src : Repeat matching lastRequest (L2-024)
end
user -> cb : Scroll end, last-option Arrow/Page Down, or Load more
alt Idle, hasMore, completed current query, enabled and not composing/pending
  cb -> src : Request pageIndex + 1 (L2-025)
  src --> cb : Page
  cb -> cb : Append; preserve active index
else Guard fails
  cb --> user : No duplicate or obsolete page request
end
@enduml
