@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - search options
class "Combobox<T>" as Combo {
  #query: WritableSignal<string>
  #results: WritableSignal<T[]>
  #status: WritableSignal<idle | loading | error>
  #hasMore: WritableSignal<boolean>
  #total: WritableSignal<number | null>
  -queries: Subject<string | null>
  -requests: Subject<{query: string, page: number}>
  -invalidated: Subject<void>
  -pageIndex: number
  -completedQuery: string | undefined
  -committedQuery: string | undefined
  -queryPending: boolean
  #retry(): void
  #loadMore(): void
  -changeQuery(text: string, open: boolean): void
}
interface "ComboboxPage<T>" as Page {
  +items: T[]
  +hasMore: boolean
  +total?: number
}
class "ComboboxSearchFn<T>" as Source <<function type>> {
  +(query: string, page: number): Observable<ComboboxPage<T>>
}
class ComboboxOption {
  +total: InputSignal<number | null>
  +position: InputSignal<number>
}
Combo ..> Source : required input
Source ..> Page : emits first page
Combo "1" --> "*" ComboboxOption : binds metadata
@enduml
