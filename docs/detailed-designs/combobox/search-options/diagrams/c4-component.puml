@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - search options
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Owns query and request Subjects, result signals, retry and loadMore")
  Component(option, "ComboboxOption", "Highlightable directive", "Binds total and one-based position from the template")
  Component(ann, "ComboboxAnnouncer", "Text queue", "Receives formatted search outcomes while open")
}
Rel(combo, option, "Binds page state and option inputs")
Rel(combo, ann, "Queues formatted outcomes")
Container_Ext(source, "Consumer searchFn", "Host function", "Observable page source; no package backend")
Rel(combo, source, "Subscribes through defer, switchMap and immediate invalidation")
@enduml
