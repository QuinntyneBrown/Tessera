@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Announce search outcomes
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box
box "Frontend - Component template" #E0F2FE
  participant "Instance live region" as live
end box
box "Frontend - Consumer source" #E0F2FE
  participant "searchFn" as src
end box


cb -> src : Request page; start 1 s loading timer
alt Timer runs while still pending and open
  cb -> ann : search(localised loading text)
end
alt Page delivered while open
  src --> cb : First page or appended page
  cb -> ann : search(singular/plural loaded count or empty message)
else Failure while open
  src --> cb : Error
  cb -> ann : failure(localised error text)
  ann -> ann : Discard search text; preserve selection queue
else Response while closed
  src --> cb : Page or error
  cb -> cb : Store state without reopening or announcing
end
ann -> ann : Polite text waits 150 ms quiet; failure bypasses quiet
ann -> live : Set priority; clear text; insert after 32 ms (L2-036)
live --> user : Expose atomic message to assistive technology
opt Edit, composition, close, disable or configuration change
  cb -> ann : cancelSearch(), including pending write
end
@enduml
