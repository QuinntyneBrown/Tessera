@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Expose state to assistive technology

Person(user, "Screen reader user", "Reads and operates the combobox through assistive technology")
System_Ext(at, "Assistive technology", "Reads the accessibility tree and live regions")
System_Boundary(browser, "Host Angular application in the browser") {
  Container(app, "Host application", "Angular", "Supplies the visible label, hint, and error text")
  Container(pkg, "@tessera/combobox", "Angular library", "Sets ARIA attributes and writes announcements")
  Container(cdk, "Angular CDK", "Library", "Provides ActiveDescendantKeyManager")
}
System_Ext(data, "Consumer data source", "Serves option pages to searchFn")

Rel(user, at, "Uses")
Rel(at, app, "Reads", "Accessibility tree")
Rel(app, pkg, "Hosts t-combobox from", "Angular template")
Rel(pkg, cdk, "Tracks the active option with")
Rel(pkg, data, "Loads option pages through", "searchFn")
@enduml
