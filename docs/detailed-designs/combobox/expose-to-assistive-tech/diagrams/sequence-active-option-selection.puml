@startuml
title UML sequence behaviour - Expose the active option and announce selection changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Screen reader user" as user
box "Frontend - Host Angular application" #E0F2FE
  participant "Host form control" as host
end box
box "Frontend - @tessera/combobox" #E0F2FE
  participant "Combobox<T>" as combobox
  participant "ComboboxOption<T>" as option
  participant "ComboboxAnnouncer" as announcer
  participant "Instance live region" as live
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "ActiveDescendantKeyManager" as manager
end box

user -> combobox : Arrow Down in the input
combobox -> manager : setNextItemActive()
manager -> option : setActiveStyles()
option -> option : Add active class; adjust only the listbox scrollTop by option bounds (L2-037 criterion 2)
manager --> combobox : change(index)
combobox -> combobox : activeOptionId() = option id; set aria-activedescendant (L2-035 criterion 4)
combobox --> user : Screen reader reads the active option; focus stays on the input (L2-037 criterion 1)

user -> combobox : Enter on the active option
combobox -> combobox : toggle(item) (L2-026)
alt Option enabled
  combobox -> host : commit(next, change) updates value; selectionChange
  combobox -> combobox : aria-selected true; summary text recomputed (L2-035 criteria 5 and 7)
  combobox -> announcer : announceSelected(label, total) (L2-036 criterion 6)
  opt Value count equals maxSelections
    combobox -> announcer : announceMaxReached(max) (L2-036 criterion 8)
  end
  announcer -> announcer : Append both messages to the pending list
  announcer -> live : announce(joined message, polite) after the quiet window
  live --> user : Reads "Ada selected. 3 selected in total. Maximum of 3 selections reached."
else Option disabled
  combobox -> combobox : toggle(item) returns; aria-disabled stays true
  combobox --> user : Nothing announced
end

user -> combobox : Backspace in the empty input, or Enter on a remove button
combobox -> host : commit(next, change) updates value; selectionChange
combobox -> announcer : announceRemoved(label) (L2-036 criterion 7)
announcer -> live : announce("label removed.", polite)

user -> combobox : Tab from the input
combobox -> combobox : Close list; remove aria-controls and aria-activedescendant (L2-035 criteria 3 and 4)
combobox --> user : Focus moves on; not trapped in the overlay (L2-037 criterion 5)
@enduml
