@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Expose active option and selection
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box
box "Frontend - Component template" #E0F2FE
  participant "Instance live region" as live
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "ActiveDescendantKeyManager" as keys
end box


user -> cb : Navigate an option
cb -> keys : Move active item without moving DOM focus
keys --> cb : change(index)
cb -> cb : activeOptionId reads generated option ID (L2-035)
cb --> user : Input references highlighted option; only listbox scrolls
user -> cb : Toggle enabled active option
cb -> cb : Commit value; update ARIA selection and summary
cb -> ann : selection(formatted selected/removed message)
opt Added item reaches maximum
  cb -> ann : selection(formatted maximum message)
end
ann -> ann : Preserve selection order; join after 150 ms quiet
ann -> live : Clear then insert joined message after 32 ms
live --> user : Selection and limit text available as one polite update
user -> cb : Tab
cb -> cb : Close; remove controls and active-descendant references
cb --> user : Native focus movement; no popup trap (L2-037)
@enduml
