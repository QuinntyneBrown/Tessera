@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - expose to assistive tech
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Binds ARIA, derives summary and listLabel, formats messages")
  Component(option, "ComboboxOption", "Directive", "Owns role, independent ID counter, states and active styles")
  Component(ann, "ComboboxAnnouncer", "Signal-backed queue", "Coalesces search text; preserves selections; sets message and priority")
  Component(live, "Instance live region", "Component template", "Binds announcer signals; exists outside popup before messages")
}
Rel(combo, option, "Discovers hosts; binds selected, disabled, label and page metadata")
Rel(combo, ann, "Calls search, selection, failure and cancelSearch")
Rel(ann, live, "Supplies message and priority signals")
Container_Ext(cdk, "Angular CDK", "Browser library", "Overlay and ActiveDescendantKeyManager")
Rel(combo, cdk, "Uses overlay and/or active-descendant APIs")
@enduml
