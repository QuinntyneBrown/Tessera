@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - expose to assistive tech
class "Combobox<T>" as Combo {
  #listId: string
  #summaryId: string
  #summary: Signal<string>
  #activeOptionId: Signal<string | null>
  #describedBy: Signal<string | null>
  #listLabel(): string
  #format(key: keyof ComboboxStrings, values: Record<string, unknown>): string
}
class ComboboxOption {
  +id: string
  +selected: InputSignal<boolean>
  +isDisabled: InputSignal<boolean>
  +active: WritableSignal<boolean>
}
class ComboboxAnnouncer {
  +message: WritableSignal<string>
  +priority: WritableSignal<polite | assertive>
  -searchMessage: string | undefined
  -selections: string[]
  +search(text: string): void
  +selection(text: string): void
  +failure(text: string): void
  +cancelSearch(): void
}
class "combobox.html live region" as Region <<template>> {
  aria-live: announcer.priority()
  aria-atomic: true
  text: announcer.message()
}
Combo "1" --> "*" ComboboxOption : viewChildren
Combo "1" *-- "1" ComboboxAnnouncer
Combo "1" *-- "1" Region : view owns DOM
Region ..> ComboboxAnnouncer : binds signals
@enduml
