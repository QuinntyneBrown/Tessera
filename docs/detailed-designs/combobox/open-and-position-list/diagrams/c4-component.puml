@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - open and position list
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Owns OverlayRef, position strategy, geometry tracking and opening mode")
  Component(option, "ComboboxOption", "Highlightable directive", "Discovered through viewChildren; reports disabled state")
  Component(fallback, "ComboboxOverlayContainer", "CDK container subclass", "Places non-popover fallback in the nearest open native dialog")
}
Rel(combo, option, "Discovers hosts and applies opening mode")
Rel(combo, fallback, "Provides component-scoped fallback")
Container_Ext(cdk, "Angular CDK", "Browser library", "Overlay and ActiveDescendantKeyManager")
Rel(combo, cdk, "Uses overlay and/or active-descendant APIs")
@enduml
