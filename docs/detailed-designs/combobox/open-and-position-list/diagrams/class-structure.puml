@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - open and position list
class "Combobox<T>" as Combo {
  #isOpen: WritableSignal<boolean>
  #activeIndex: WritableSignal<number>
  -openingMode: normal | last | none
  -needsActivation: boolean
  -popup: OverlayRef | undefined
  -popupPosition: FlexibleConnectedPositionStrategy | undefined
  -widthObserver: ResizeObserver | undefined
  #open(mode: normal | last | none): void
  #close(): void
  -updatePopupGeometry(): void
  -stopPopupTracking(): void
}
class OverlayRef <<CDK>> {
  +attach(portal: Portal): void
  +detach(): void
  +updateSize(size: OverlaySizeConfig): void
  +updatePosition(): void
  +dispose(): void
}
class FlexibleConnectedPositionStrategy <<CDK>> {
  +withPositions(positions: ConnectedPosition[]): this
  +withPopoverLocation(location: inline): this
}
class "ActiveDescendantKeyManager<ComboboxOption>" as Keys <<CDK>>
class ComboboxOption {
  +disabled: boolean <<getter>>
  +setActiveStyles(): void
}
class OverlayContainer <<CDK>>
class ComboboxOverlayContainer {
  #_createContainer(): void
}
Combo "1" *-- "0..1" OverlayRef
OverlayRef --> FlexibleConnectedPositionStrategy : positions with
Combo "1" *-- "0..1" Keys
Keys o-- "*" ComboboxOption : tracks discovered hosts
OverlayContainer <|-- ComboboxOverlayContainer
Combo ..> ComboboxOverlayContainer : scoped provider
@enduml
