@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Position and resize the list
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "OverlayRef / connected position" as overlay
end box
box "Frontend - Browser" #E0F2FE
  participant "Field / visual viewport" as browser
end box


cb -> overlay : Connect to field; inline popover; reposition strategy
overlay -> browser : Insert host after field; enter top layer (L2-030)
cb -> browser : Reveal input if outside visual viewport
browser --> cb : Field, row, status and viewport bounds
cb -> cb : Choose room above/below; short-height row offsets
cb -> overlay : Set field width and bounded panel height; update position
overlay --> user : Popup keeps input clear
loop Open-state resize, ancestor scroll or render
  browser -> cb : Observer, document capture, window/visualViewport event
  cb -> overlay : Refresh geometry (ignore scroll inside pane)
end
opt Close or destroy
  cb -> browser : Disconnect field observer and remove explicit listeners
  cb -> overlay : Detach on close; dispose on destroy
end
note over cb, browser
  Without popovers, scoped container stays in nearest open native dialog.
  Fallback loses inline reading order; theme copied at attachment.
end note
@enduml
