@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Open and close the list
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "OverlayRef" as overlay
  participant "ActiveDescendantKeyManager" as keys
end box


alt Focus alone
  user -> cb : Focus input
  cb --> user : Popup remains closed (L2-029)
else Opening trigger
  user -> cb : Type, Arrow Up/Down, Alt Down, field or toggle click
  cb -> overlay : Create lazily; attach TemplatePortal
  overlay --> cb : Panel attached inline after field
  cb -> keys : After render apply normal, last or none mode
  cb --> user : opened once; no focus trap
end
opt First page arrives
  cb -> keys : needsActivation applies preserved opening mode
end
user -> cb : Escape, Alt Up, Tab, outside pointer, toggle or disable
cb -> cb : Clear active state and queued search messages; stop tracking
cb -> overlay : Detach panel; retain reusable reference
overlay --> cb : Detached
cb --> user : closed once; browser focus behavior retained (L2-029)
note over cb
  Tooltip Escape has priority. Popup-action Escape focuses input.
  Chip Escape preserves chip focus. Tab is never prevented.
end note
@enduml
