@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - customize and localise
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Merges defaults and partial overrides once; formats owned text")
  Component(strings, "COMBOBOX_I18N / DEFAULT_COMBOBOX_STRINGS", "Token and constant", "Partial overrides and English defaults")
  Component(format, "formatComboboxString", "Internal pure function", "Substitutes supplied placeholders in one pass")
  Component(slots, "Three template directives", "Typed content slots", "Expose option, chip and empty TemplateRef values")
  Component(ann, "ComboboxAnnouncer", "Text queue", "Receives already formatted strings")
}
Rel(combo, strings, "Resolves strings at construction")
Rel(combo, format, "Formats current values")
Rel(combo, slots, "Reads contentChild and renders ngTemplateOutlet")
Rel(combo, ann, "Passes plain message text")
@enduml
