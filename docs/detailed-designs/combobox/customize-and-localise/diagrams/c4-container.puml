@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Customize, localise, and publish the API

Person(dev, "Consumer developer", "Configures the component")
System_Boundary(app, "Host Angular application") {
  Container(hostcode, "Host templates and providers", "Angular", "Binds inputs and outputs, provides COMBOBOX_I18N, and supplies slot templates")
  Container(pkg, "@tessera/combobox", "Angular library", "t-combobox, slot directives, string source, public API")
  Container(cdk, "@angular/cdk", "Angular library", "Overlay and key manager used by the package")
}
System_Ext(source, "Consumer data source", "Answers searchFn calls")
Container(build, "Package build and API check", "Angular CLI, ng-packagr, api-extractor", "Builds dist/combobox and compares its API with the golden")
ContainerDb(golden, "Public API golden", "api-extractor report", "goldens/combobox/index.api.md")
Rel(dev, hostcode, "Writes")
Rel(hostcode, pkg, "Binds inputs, outputs, slots, and COMBOBOX_I18N of", "Angular template and providers")
Rel(pkg, cdk, "Uses", "TypeScript import")
Rel(pkg, source, "Calls searchFn on", "Consumer-defined")
Rel(build, pkg, "Builds and extracts API from")
Rel(build, golden, "Compares with and updates")
@enduml
