@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - customize and localise
class "Combobox<T>" as Combo {
  #strings: ComboboxStrings
  #format(key: keyof ComboboxStrings, values: Record<string, unknown>): string
  +searchFn: InputSignal<ComboboxSearchFn<T>>
  +value: ModelSignal<T[]>
}
interface ComboboxStrings {
  25 string keys: rows, names, summary and announcements
}
class COMBOBOX_I18N <<InjectionToken>> {
  Partial<ComboboxStrings>
}
class "formatComboboxString" as Format <<function>> {
  +(template: string, values: Record<string, unknown>): string
}
class "ComboboxOptionTemplate<T>" as OptionSlot {
  +template: TemplateRef<ComboboxOptionContext<T>>
}
class "ComboboxChipTemplate<T>" as ChipSlot {
  +template: TemplateRef<ComboboxChipContext<T>>
}
class ComboboxEmptyTemplate {
  +template: TemplateRef<ComboboxEmptyContext>
}
interface "ComboboxOptionContext<T>" as OptionContext {
  +$implicit: T
  +selected: boolean
  +active: boolean
}
interface "ComboboxChipContext<T>" as ChipContext {
  +$implicit: T
}
interface ComboboxEmptyContext {
  +query: string
}
Combo ..> COMBOBOX_I18N : merges once over defaults
Combo --> ComboboxStrings : resolved object
Combo ..> Format : formats before queueing
Combo "1" o-- "0..1" OptionSlot : contentChild
Combo "1" o-- "0..1" ChipSlot : contentChild
Combo "1" o-- "0..1" ComboboxEmptyTemplate : contentChild
OptionSlot ..> OptionContext
ChipSlot ..> ChipContext
ComboboxEmptyTemplate ..> ComboboxEmptyContext
@enduml
