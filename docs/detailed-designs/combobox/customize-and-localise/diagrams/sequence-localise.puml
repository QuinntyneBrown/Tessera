@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Resolve and apply localised strings
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Announcement queue" #E0F2FE
  participant "ComboboxAnnouncer" as ann
end box
box "Frontend - Component template" #E0F2FE
  participant "Instance live region" as live
end box
box "Frontend - Host providers" #E0F2FE
  participant "COMBOBOX_I18N overrides" as host
end box


host -> cb : Supply partial ComboboxStrings (L2-041)
cb -> cb : Merge once over DEFAULT_COMBOBOX_STRINGS
cb --> user : Owned names and rows use resolved strings
user -> cb : Select an item
cb -> cb : Select singular/plural key; format placeholders once
cb -> ann : selection(already formatted text)
ann -> live : Signal-backed text update after queue timing
live --> user : Localised announcement text
note over cb
  Unknown placeholders remain literal; substituted labels are not expanded again.
  A locale change recreates the instance with new providers.
end note
@enduml
