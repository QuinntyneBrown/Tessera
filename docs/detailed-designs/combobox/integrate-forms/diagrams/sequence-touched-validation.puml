@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Touched and validation state
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular Forms" #E0F2FE
  participant "Current AbstractControl" as fc
end box


cb -> fc : Resolve NgControl in ngOnInit; bind current control after render
fc --> cb : events update controlVersion and disabled state
user -> cb : focusout
alt relatedTarget inside host or popup pane
  cb -> cb : Leave touched unchanged (L2-031)
else Genuine exit, including null target
  cb -> cb : localTouched true
  cb -> fc : onTouched once per exit
  fc --> cb : Current touched and invalid state
  cb --> user : Invalid state; error before hint when text exists
end
opt Control replaced or reset
  cb -> fc : Rebind identity; unsubscribe old events
  fc --> cb : Refresh touched, invalid, disabled and required state
end
note over cb
  Without forms, local touched plus required/empty value drives errors.
  Form reset clears form touched; it does not reset localTouched.
end note
@enduml
