@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Write and change the form value
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Angular Forms and host" #E0F2FE
  participant "Control / model binding" as fc
end box


fc -> cb : writeValue(array or null)
cb -> cb : Remember synchronized array; null becomes [] (L2-031)
cb --> user : Chips update without user-change event
user -> cb : Toggle or remove a value
cb -> cb : Remember array before model watcher; set value
cb -> fc : onChange(next) and selectionChange (L2-031)
fc -> fc : Commit at configured change, blur or submit boundary
opt External model array with forms present
  fc -> cb : New model value
  cb -> fc : Identity-guarded setValue once; no dirty or selectionChange
end
opt No forms
  cb --> fc : valueChange updates two-way model (L2-032)
end
@enduml
