@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - integrate forms
interface ControlValueAccessor {
  +writeValue(value): void
  +registerOnChange(fn): void
  +registerOnTouched(fn): void
  +setDisabledState(disabled: boolean): void
}
class "Combobox<T>" as Combo {
  +value: ModelSignal<T[]>
  -synchronizedValue: T[] | undefined
  -ngControl: NgControl | null
  -boundControl: AbstractControl | null
  -controlVersion: WritableSignal<number>
  #localTouched: WritableSignal<boolean>
  #isRequired: Signal<boolean>
  #showError: Signal<boolean>
  +writeValue(value: T[] | null): void
  +setDisabledState(disabled: boolean): void
  #onFocusout(event: FocusEvent): void
  -bindControl(): void
}
class NgControl <<Angular Forms>> {
  +control: AbstractControl | null
}
class AbstractControl <<Angular Forms>> {
  +events: Observable<ControlEvent>
  +touched: boolean
  +invalid: boolean
  +disabled: boolean
  +setValue(value): void
}
Combo ..|> ControlValueAccessor
Combo --> NgControl : resolves lazily
NgControl --> AbstractControl : current control
Combo --> AbstractControl : subscribes and rebinds
@enduml
