@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Adapt to viewport and color settings
actor "Application user" as user
box "Frontend - Package" #E0F2FE
  participant "Combobox<T>" as cb
end box
box "Frontend - Browser" #E0F2FE
  participant "CSS engine / viewport" as style
  participant "ResizeObserver" as observer
end box
box "Frontend - Angular CDK" #E0F2FE
  participant "OverlayRef" as overlay
end box


user -> style : Change viewport, zoom, text size or spacing
style -> cb : Wrapping field and bounded chip list reflow (L2-039)
style -> observer : Field dimensions change
observer -> cb : Geometry update
cb -> overlay : Full field width; bounded height; input-row offsets if needed
overlay --> user : Input clear; listbox scrolls within panel
user -> style : Dark theme or forced colors
style -> cb : Apply palette or system-color tokens (L2-038)
cb --> user : Borders, outline and checkmark remain distinct
user -> style : Reduced-motion preference
style --> user : No animations or transitions under either preference
note over cb
  State and input focus persist. Actual zoom is verified manually;
  automated 320 by 256 viewport establishes reflow only.
end note
@enduml
