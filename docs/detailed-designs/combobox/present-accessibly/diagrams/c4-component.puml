@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - present accessibly
Container_Boundary(pkg, "Host Angular application in the browser") {
  Component(combo, "Combobox<T>", "Angular component", "Owns template, click handlers and overlay geometry")
  Component(styles, "combobox.scss", "Stylesheet", "Defines wrapping, ellipsis, tokens, system colors and static motion")
  Component(option, "ComboboxOption", "Directive", "Owns option state and active outline")
  Component(fallback, "ComboboxOverlayContainer", "CDK container subclass", "Keeps fallback content in native dialog")
}
Rel(combo, styles, "Uses layout and theme properties")
Rel(combo, option, "Binds state and renders decorative SVG")
Rel(combo, fallback, "Provides fallback placement")
Container_Ext(cdk, "Angular CDK", "Browser library", "Overlay and ActiveDescendantKeyManager")
Rel(combo, cdk, "Uses overlay and/or active-descendant APIs")
@enduml
