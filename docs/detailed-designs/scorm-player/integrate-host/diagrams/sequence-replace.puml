@startuml
title UML sequence behaviour - Replace the source or attempt
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "ActivityLauncher" as launcher
  participant "RuntimeBridge" as bridge
  participant "PersistenceCoordinator" as persist
  participant "HostIntegration" as host
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper" as wrapper
end box
box "Backend - Host LMS API application" #D1FADF
  participant "Authorized attempt storage" as api
end box

actor -> shell : Change source or attempt
shell -> launcher : ActivityLauncher.flush() under the old context (L2-021)
launcher -> bridge : flush()
bridge -> wrapper : Request flush
alt Flush reply missing or failed
  bridge --> shell : Runtime error; replacement stays blocked
  shell --> actor : Offer retry (re-runs this flush) or explicit loss decision; accepting loss discards the wrapper and continues the replacement
else Flush reply after prior operations
  wrapper --> bridge : Flush reply
  bridge -> persist : submit(snapshot)
  shell -> persist : drain()
  persist -> host : saveState(old context, submission, signal)
  host -> api : Save under old authorized attempt
  api --> host : Acknowledgement or failure
  host --> persist : Save result
  alt Save acknowledged
    persist --> shell : Drained
    shell -> launcher : retireCurrent()
    shell --> actor : Load replacement context
  else Progress unsaved
    persist --> shell : Failure; latest state and old context kept
    shell --> actor : Offer retry or explicit loss decision
  end
end
@enduml
