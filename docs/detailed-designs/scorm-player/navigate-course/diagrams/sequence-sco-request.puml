@startuml
title UML sequence behaviour - Process a SCORM 2004 navigation request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "RuntimeBridge / host RuntimeSession" as bridge
  participant "NavigationController / SequencingEngine" as core
  participant "ActivityLauncher" as launcher
  participant "PersistenceCoordinator" as persist
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper / local API" as wrapper
  participant "SCO / asset" as sco
end box

sco -> wrapper : Set valid adl.nav.request (L2-006)
wrapper -> wrapper : Validate request under detected edition
wrapper --> sco : Synchronous result
sco -> wrapper : Terminate session
wrapper -> bridge : Terminate with navigation request after prior operations
bridge -> bridge : Validate; submit final snapshot (see run-scorm-session finish)
bridge -> core : NavigationController.request(SCO navigation request) with validated final state
core -> core : Update objectives and attempt counts
core -> core : Apply edition sequencing and rollup (L2-006)
core -> persist : submit(snapshot with updated SequencingState)
alt Result selects activity
  core -> launcher : launch(selected activity)
  launcher -> wrapper : Retire terminated binding; create new wrapper iframe
  wrapper --> launcher : Ready
  launcher --> core : Launched
  core -> core : Set SequencingState.currentActivityId
  core -> persist : submit(snapshot with updated SequencingState)
  core --> shell : Updated position and availability
else Result ends attempt
  core -> persist : drain() for the submitted termination and sequencing state
  persist --> core : Settled with acknowledgement, or failed
  core --> shell : End decision with save status
else Request disallowed
  core --> shell : Keep permitted position and reason
end
alt New activity and the retired iframe held focus
  shell --> actor : Move focus to activity heading; no live-region announcement
else Otherwise
  shell --> actor : Announce the new activity, the ended attempt, or the denial reason
end
@enduml
