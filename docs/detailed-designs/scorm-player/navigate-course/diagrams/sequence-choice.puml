@startuml
title UML sequence behaviour - Choose, move previous, or move next
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "NavigationController / SequencingEngine" as core
  participant "ActivityLauncher" as launcher
  participant "RuntimeBridge / host RuntimeSession" as bridge
  participant "PersistenceCoordinator" as persist
  participant "HostIntegration" as host
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper / local API" as wrapper
end box

actor -> shell : Choose activity, Previous, or Next
shell -> core : request(navigationIntent)
core -> core : Evaluate availability for edition (L2-005 / L2-006)
alt Denied or boundary reached
  core --> shell : Denied decision with reason
  shell --> actor : Convey unavailable state and text reason
else Launch permitted
  core -> launcher : launch(selected activity)
  launcher -> bridge : flush()
  bridge -> wrapper : Request flush
  wrapper --> bridge : Flush reply after prior operations
  bridge -> persist : submit(snapshot); navigation does not wait (L2-013)
  persist -> host : saveState(context, submission, signal)
  bridge --> launcher : Flushed
  launcher -> launcher : Retire old binding
  launcher -> wrapper : Create new wrapper iframe for selected resource
  wrapper --> launcher : New activity ready
  launcher --> core : Launched
  core -> core : Set SequencingState.currentActivityId
  core -> persist : submit(snapshot with updated SequencingState)
  core --> shell : Current position and permitted actions
  shell --> actor : Move focus to activity heading
end
@enduml
