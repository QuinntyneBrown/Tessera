@startuml
title Class structure - Navigate permitted course activities
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class NavigationController {
  +request(request: NavigationRequest): Promise<NavigationDecision>
  +availableActions(): NavigationDecision[]
}
class SequencingEngine {
  +edition: ScormEdition
  +evaluate(request: NavigationRequest, state: SequencingState): NavigationDecision
  +rollup(state: SequencingState): RollupResult
}
class SequencingState {
  +currentActivityId: string
  +activityAttempts: Map<string, number>
  +objectives: Map<string, ObjectiveState>
}
class NavigationDecision {
  +kind: launch | end | denied
  +activityId: string
  +reason: string
}
class ActivityLauncher {
  +retireCurrent(): Promise<void>
  +launch(activity: Activity): Promise<void>
}
NavigationController --> SequencingEngine : evaluates
SequencingEngine --> SequencingState : reads and updates
SequencingEngine ..> NavigationDecision : produces
NavigationController --> ActivityLauncher : executes approved decision
@enduml
