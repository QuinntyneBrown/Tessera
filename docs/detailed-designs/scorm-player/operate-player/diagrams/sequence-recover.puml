@startuml
title UML sequence behaviour - Present categorized failure and retry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "NavigationController" as nav
  participant "CourseLoader / ActivityLauncher / PersistenceCoordinator" as core
  participant "HostIntegration" as host
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper / local API" as wrapper
end box
box "Backend - Host LMS API application" #D1FADF
  participant "Authorized attempt storage" as api
end box
box "Backend - Host course delivery infrastructure" #FFF4E5
  participant "Course delivery service" as delivery
end box

core --> shell : PlayerError(category, code, text, correlationToken)
shell -> shell : Publish actionable message (L2-020)
shell --> actor : PlayerEvent error (category, code, correlationToken)
shell --> actor : Announce failure and available action (L2-017)
actor -> shell : Activate Retry by keyboard; retry(error) routes by category
alt Loading failure, manifest or package code
  shell -> core : CourseLoader.load(source, limits, signal)
  opt Extracted source
    core -> delivery : Fetch manifest
    delivery --> core : Manifest or loading error
  end
else Loading failure, activity launch code
  shell -> nav : navigate(request) for the error's activityId calls NavigationController.request, which re-checks it
  nav -> core : ActivityLauncher.launch(activity)
  core -> wrapper : Create new wrapper iframe
  wrapper -> delivery : Same-origin recheck of the launch resource
  delivery --> wrapper : Resource or HTTP failure
  wrapper --> core : Launch check result
else Persistence failure
  shell -> core : PersistenceCoordinator.retry()
  core -> host : saveState(context, submission, signal)
  host -> api : Authorized revision save
  api --> host : Save result
  host --> core : Matching acknowledgement or failure
else Detected runtime failure
  shell -> nav : navigate(request) for the current activity calls NavigationController.request
  nav -> core : ActivityLauncher.launch(activity)
  core -> wrapper : Discard the failed wrapper (no flush); create new wrapper iframe
  wrapper --> core : Relaunched with retained state, or runtime error
end
core --> shell : Recovered state or actionable failure
alt Activity relaunched
  shell --> actor : Move focus to activity heading; no live-region announcement
else Course reloaded or progress saved again
  shell --> actor : Announce course ready (unless focus moved to the activity heading) or return to saved in the polite region
else Still failing
  shell --> actor : Show the new error in its region without exposing learner data
end
@enduml
