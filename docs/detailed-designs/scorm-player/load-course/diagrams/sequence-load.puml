@startuml
title UML sequence behaviour - Load either supported source
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "CourseLoader" as core
  participant "PackageWorker" as worker
  participant "HostIntegration" as host
end box
box "Backend - Host LMS API application" #D1FADF
  participant "Authorized attempt storage" as api
end box
box "Backend - Host course delivery infrastructure" #FFF4E5
  participant "Course delivery service" as delivery
end box

actor -> shell : Supply source
shell --> actor : Render shell and loading status (L2-019)
shell -> core : load(source, limits, signal)
alt ZIP input
  core -> core : Check archive bytes (L2-002)
  core -> worker : extract(file, limits, signal)
  worker -> worker : Count expanded bytes and entries; parse manifest; confine paths (L2-001 / L2-016)
  worker --> core : ValidatedCourse or typed failure
else Extracted input
  core -> delivery : Fetch manifest under configured CORS policy (L2-001)
  delivery --> core : Manifest XML or fetch error (L2-003)
  core -> core : Detect edition; parse structure; confine paths (L2-001 / L2-016)
end
alt Invalid source or exceeded limit
  core --> shell : Typed loading failure; no executable content
  shell --> actor : Name the cause (e.g. which limit was exceeded); offer Retry only when error.retryable
else Validated source
  core --> shell : ValidatedCourse
  shell -> host : prepareDelivery(context, course, signal)
  host -> api : Authorize delivery for this attempt
  api --> host : Isolated delivery descriptor
  host --> shell : Prepared course root
  shell --> actor : Show course title and available activities
end
@enduml
