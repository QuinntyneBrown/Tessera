@startuml
title UML sequence behaviour - Commit, terminate, and retire a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "ActivityLauncher" as launcher
  participant "Host RuntimeSession / RuntimeBridge" as core
  participant "PersistenceCoordinator" as persist
  participant "HostIntegration" as host
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper / local API" as wrapper
  participant "SCO / asset" as sco
end box
box "Backend - Host LMS API application" #D1FADF
  participant "Authorized attempt storage" as api
end box

sco -> wrapper : Commit or terminate (L2-010)
wrapper -> wrapper : Validate lifecycle and empty argument
wrapper -> core : Post commit or terminate after prior writes
wrapper --> sco : Edition result under verified policy (<TO SUPPLY>)
core -> core : Apply prior operations in order (L2-009)
core -> persist : submit(snapshot)
persist -> host : saveState(context, submission, signal)
sco -> wrapper : Call API after Terminate, before retirement
wrapper --> sco : Edition-specific terminated-session error (L2-010)
opt Activity replacement after Commit; a validated Terminate already counts as the flush (does not await the save acknowledgement)
  launcher -> core : flush()
  core -> wrapper : Request flush
  wrapper --> core : Flush reply after prior operations
  core --> launcher : Flushed; state retained
  launcher -> launcher : retireCurrent() removes old iframe and binding (L2-010)
  wrapper -> core : Late message from removed window
  core -> core : Reject; replacement state unchanged
end
host -> api : Authorize and persist immutable snapshot
api --> host : Save acknowledgement or failure
host --> persist : Durable result
persist --> shell : Saved status or retained unsaved state
@enduml
