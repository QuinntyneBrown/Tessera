@startuml
title UML sequence behaviour - Restore the bound attempt
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner / host integrator" as actor
box "Frontend - Host LMS application" #E0F2FE
  participant "ScormPlayer" as shell
  participant "AttemptRestorer / OutcomeCalculator" as core
  participant "NavigationController" as nav
  participant "ActivityLauncher" as launcher
end box
box "Frontend - Isolated course context" #E0F2FE
  participant "CourseWrapper" as wrapper
end box

actor -> shell : Reopen authorized attempt
shell -> shell : Holds the AttemptSnapshot or null from loadAttempt (integrate-host) and the ValidatedCourse (load-course)
shell -> core : restore(context, course, snapshot)
core -> core : Validate context, edition and schema (L2-011)
alt Snapshot mismatch or unsupported schema
  core --> shell : Integration error; refuse restore
  shell --> actor : Explain state mismatch
else null: new attempt
  core -> core : Create edition defaults without old state
  core --> shell : Initial permitted activity
  shell -> nav : navigate(request) calls NavigationController.request for the initial activity
  nav -> launcher : launch(activity); then set SequencingState.currentActivityId
  launcher -> wrapper : prepare(empty ScoSnapshot) before API discovery
  shell --> actor : Present current position and known outcomes; announce course ready with the current activity unless focus moved to the activity heading
else Valid saved attempt
  core -> core : Restore per-SCO data and sequencing state
  core --> shell : RestoredAttempt with saved currentActivityId
  shell -> nav : navigate(request) calls NavigationController.request for the saved activity
  nav -> nav : Permit the saved activity under current rules, or deny (fallback <TO SUPPLY>)
  nav -> launcher : launch(activity); then set SequencingState.currentActivityId
  launcher -> wrapper : prepare(ScoSnapshot) before API discovery
  shell --> actor : Present current position and known outcomes; announce course ready with the current activity unless focus moved to the activity heading
end
@enduml
